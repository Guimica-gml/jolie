proc puts(cstr: ^uint8) {
    while ^cstr {
        putc(^cstr);
        cstr = + cstr 1;
    }
}

proc main() {
    puts("Hello, world!\n");
    puts("Hello, jolie!\n");

    let list_len: uint64 = 3;
    let list: ^uint64 = make_array(uint64, list_len); # stack allocated

    list[0] = 12;
    list[1] = 13;
    list[2] = 14;

    putd(list);
    let i: uint64 = 0;
    while < i list_len {
        putd(list[i]);
        i = + i 1;
    }

    putd(+ 20 5);
    putd(- 20 5);
    putd(/ 20 5);
    putd(* 20 5);
}
