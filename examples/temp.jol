proc puts(cstr: ^uint8) {
    while cast(bool) ^cstr {
        putc(^cstr);
        cstr = + cstr cast(^uint8) 1;
    }
}

proc putd(a: uint64) {
    let i: uint64 = 0;
    while < i 10 {
        print_urmom(i);
        i = + i 1;
    }
}

proc main(): uint32 {
    if < 0 1 {
        puts("< 0 1");
    }

    let urmom: uint64 = + urdad("reversed") 69;
    print_urmom(urmom);

    let i: uint64 = 0;
    while < i 10 {
        putd(i);
        i = + i 1;
    }

    puts("Hey! Listen\n");
    return cast(uint32) 0;
}
